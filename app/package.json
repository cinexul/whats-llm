		"test:e2e:pwa": "playwright test --config=playwright.pwa.config.ts",
		"content:check": "node scripts/content-maintenance.mjs check",
		"check:content": "npm run content:check",
		"check:quiz": "node scripts/check-quiz-registry.mjs"
	},
	"devDependencies": {
		"@fontsource/jetbrains-mono": "^5.2.8",
		"@fontsource/noto-sans-jp": "^5.2.9",
		"@fontsource/noto-serif-jp": "^5.2.8",
		"@playwright/test": "^1.64.1",
		"@shikijs/langs": "^4.5.0",
		"@shikijs/themes": "^4.5.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tauri-apps/cli": "^2.11.3",
		"@types/node": "^24.19.2",
		"fake-indexeddb": "^6.2.6",
		"jsdom": "^30.1.3",
