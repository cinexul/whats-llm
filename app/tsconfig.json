{
	"extends": "./.svelte-kit/tsconfig.json",
	"compilerOptions": {
		"rewriteRelativeImportExtensions": true,
		"allowJs": true,
		"checkJs": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"sourceMap": true,
		"strict": true,
		"moduleResolution": "bundler"
	}
	// 路径别名的配置见https://svelte.dev/docs/kit/configuration#alias
	// $lib除外，其配置见https://svelte.dev/docs/kit/configuration#files
	//
	// 如需修改include、exclude等顶层选项，建议扩展自动生成的配置；
	// 详见https://svelte.dev/docs/kit/configuration#typescript
}
